# Copy this file to .env.local and fill in the values.

# The shared password everyone on the team uses to sign in. Pick anything —
# there are no individual accounts.
APP_PASSWORD=choose-a-shared-password

# From your Supabase project's dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / "publishable" key (NOT the service_role / secret key). This is
# safe by design — the app's Row Level Security policies (see
# supabase/schema.sql) grant this key full read/write, since the shared
# password above is the actual access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
