# Copy this file to .env.local and fill in the values.

# The shared password everyone on the team uses to sign in. Pick anything —
# there are no individual accounts.
APP_PASSWORD=choose-a-shared-password

# From the Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "service_role" key, NOT the anon key. This is a server-only secret —
# never expose it to the browser or commit it. The app has no other DB
# credential and no Row Level Security, so this key is the only thing
# standing between the internet and the database; keep it out of any
# NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
